# 이 파일은 예시입니다. 실제 값은 넣지 말고, 같은 폴더에 ".env" 파일을 새로 만들어 실제 키를 넣으세요.
# ".env" 파일은 Git에 올리지 않습니다(.gitignore에 등록되어 있습니다).

# Google AI Studio(https://aistudio.google.com/)에서 발급받은 Gemini API 키
GEMINI_API_KEY=

# --- 아래는 STEP 12~13(Slack/Gmail 발송)에서 사용 예정. 지금 당장 입력할 필요는 없습니다. ---
# 변수명/인증 방식은 STEP 12~13 착수 시 각 서비스의 공식 문서로 다시 확인합니다(여기 이름은 가장 흔히
# 쓰이는 방식을 기준으로 한 예시이며, 실제 구현 시 바뀔 수 있습니다).

# Slack — Incoming Webhook 방식(가장 간단)을 쓸 경우
SLACK_WEBHOOK_URL=

# (대안) Slack — Bot Token 방식을 쓸 경우
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=

# Gmail — 앱 비밀번호 방식(2단계 인증 계정에서 발급)을 쓸 경우
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_TO_ADDRESS=
